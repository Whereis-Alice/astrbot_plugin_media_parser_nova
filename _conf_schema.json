    "trigger": {
        "description": "触发设置",
        "type": "object",
        "items": {
            "auto_parse": {
                "description": "自动解析链接",
                "type": "bool",
                "default": true
            },
            "reply_trigger": {
                "description": "回复触发解析",
                "type": "bool",
                "hint": "引用含链接的消息并附关键词即可触发解析；与自动解析可同时开启。",
                "default": false
            },
            "keywords": {
                "description": "手动触发关键词",
                "type": "list",
                "hint": "自动解析关闭时用于普通消息；启用“回复触发解析”时也用于引用消息。消息包含任一关键词才触发；每项填写一个关键词。",
                "items": {
                    "type": "string"
                },
                "default": [
                    "视频解析",
                    "解析视频",
                    "媒体解析"
                ]
            }
        }
    },
    "parse_rate_limit": {
        "description": "解析频率限制",
        "type": "object",
        "hint": "最多解析次数填 0 表示不限制；启用限制时，时间窗必须大于 0。记录会持久化到插件运行时目录并自动裁剪。",
        "items": {
            "same_link": {
                "description": "同链接限制",
                "type": "object",
                "hint": "链接会先清洗为标准链接，过滤分享者、来源和追踪参数后再计数。",
                "items": {
                    "max_count": {
                        "description": "最多解析次数",
                        "type": "int",
                        "hint": "同一标准链接在时间窗内最多解析的次数；0 = 不限制",
                        "default": 0
                    },
                    "window_seconds": {
                        "description": "时间窗秒数",
                        "type": "int",
                        "hint": "必须大于 0；填 0 会关闭此限制。只统计该秒数内的记录，也用于自动裁剪持久化记录。",
                        "default": 3600
                    }
                }
            },
            "same_user": {
                "description": "同用户限制",
                "type": "object",
                "hint": "按消息发送者 ID 计数；一条消息内解析多个链接会分别计数。",
                "items": {
                    "max_count": {
                        "description": "最多解析次数",
                        "type": "int",
                        "hint": "同一用户在时间窗内最多解析的链接数；0 = 不限制",
                        "default": 0
                    },
                    "window_seconds": {
                        "description": "时间窗秒数",
                        "type": "int",
                        "hint": "必须大于 0；填 0 会关闭此限制。只统计该秒数内的记录，也用于自动裁剪持久化记录。",
                        "default": 3600
                    }
                }
            }
        }
    },
    "message": {
        "description": "消息输出",
        "type": "object",
        "hint": "按文本元数据、富媒体、附加内容和发送行为分区；字段开关只影响展示，不隐藏错误与媒体状态。",
        "items": {
            "text_metadata": {
                "description": "文本元数据",
                "type": "object",
                "hint": "分别控制解析摘要中的来源字段；关闭字段也不会影响解析、下载或错误提示。",
                "items": {
                    "show_title": {
                        "description": "显示标题",
                        "type": "bool",
                        "default": true
                    },
                    "show_author": {
                        "description": "显示作者",
                        "type": "bool",
                        "default": true
                    },
                    "show_timestamp": {
                        "description": "显示发布时间",
                        "type": "bool",
                        "default": true
                    },
                    "show_original_link": {
                        "description": "显示原始链接",
                        "type": "bool",
                        "hint": "关闭后不在解析结果中重复展示原链接。",
                        "default": true
                    },
                    "show_description": {
                        "description": "显示简介/正文",
                        "type": "bool",
                        "hint": "适合正文较长、只希望保留简短摘要的群聊。",
                        "default": true
                    },
                    "quote_user_message": {
                        "description": "引用用户消息",
                        "type": "bool",
                        "hint": "仅普通逐条发送时生效；聚合和 ZIP 不引用。只让文本元数据节点引用对应用户消息，媒体节点不引用。",
                        "default": false
                    }
                }
            },
            "media_display": {
                "description": "富媒体展示",
                "type": "object",
                "items": {
                    "video_cover_only": {
                        "description": "视频仅发送封面",
                        "type": "bool",
                        "hint": "开启后不发送视频节点；每个视频会改为发送封面图片。解析结果有封面时直接使用封面，否则尝试截取视频第一帧。",
                        "default": false
                    }
                }
            },
            "card_render": {
                "description": "附加内容：卡片渲染",
                "type": "object",
                "hint": "将标题、作者、正文等信息渲染为卡片图片；是否发送普通文本、以及卡片和文本是否同条发送，只由下面的“卡片模式”决定。",
                "items": {
                    "enable": {
                        "description": "启用卡片渲染",
                        "type": "bool",
                        "hint": "依赖 Pillow；渲染失败自动回退纯文本",
                        "default": false
                    },
                    "mode": {
                        "description": "卡片模式",
                        "type": "string",
                        "options": [
                            "卡片+文本同条发送",
                            "卡片+文本分开发",
                            "仅卡片"
                        ],
                        "hint": "这是卡片与普通文本发送方式的唯一开关。同条发送：卡片图和第一段文本位于同一消息链，超长文本按平台限制续发；分开发：卡片图单独发送；仅卡片：不发送普通文本，只随卡片保留原始链接。",
                        "default": "卡片+文本同条发送"
                    },
                    "custom_font": {
                        "description": "自定义字体路径",
                        "type": "string",
                        "hint": "留空使用内置字体（恒宋云朗黑体）；支持 .ttf/.otf/.ttc",
                        "default": ""
                    },
                    "theme": {
                        "description": "深浅配色",
                        "type": "string",
                        "options": [
                            "深色",
                            "浅色"
                        ],
                        "hint": "对所有风格都生效：6 套皮肤各自都有深色与浅色两版配色，本项在任意皮肤下都会真实改变背景、文字与面板颜色。深浅（2）× 皮肤（6）× 布局（4）共 48 种组合都可用。哔哩哔哩皮肤的品牌粉与品牌蓝在两种模式下保持原样。",
                        "default": "深色"
                    },
                    "layout": {
                        "description": "版式布局",
                        "type": "string",
                        "options": [
                            "标准",
                            "杂志",
                            "沉浸式",
                            "信息流"
                        ],
                        "hint": "对所有风格都生效：布局只改变区块的空间组织方式，与皮肤、深浅配色自由组合。标准 = 单栏顺序排布；杂志 = 左右分栏，作者、数据与引用移入侧栏；沉浸式 = 全幅大图压标题、标题更大；信息流 = 紧凑单栏、多图拼贴、字号更小。",
                        "default": "标准"
                    },
                    "skin": {
                        "description": "卡片风格",
                        "type": "string",
                        "options": [
                            "极光",
                            "报章",
                            "测控",
                            "展陈",
                            "夜曲",
                            "哔哩哔哩"
                        ],
                        "hint": "6 套皮肤各有独立的背景、装饰、面板、区块顺序与排版策略：极光 = 网格渐变玻璃卡；报章 = 纸纹报纸排印、首字下沉；测控 = 深色栅格数据面板；展陈 = 画廊展签、编号图注；夜曲 = 午夜霓虹、图像居中；哔哩哔哩 = 还原 B 站视频卡片（小电视标志、UP 主行、图标统计）。旧配置里的 Nova 原生 / 编辑室 / 信号终端 / 海报档案 / 霓虹夜景 / B站动态会自动映射为极光 / 报章 / 测控 / 展陈 / 夜曲 / 哔哩哔哩，无需手动改。",
                        "default": "极光"
                    },
                    "width": {
                        "description": "卡片宽度",
                        "type": "int",
                        "hint": "范围 520-1080 像素",
                        "default": 800
                    },
                    "cover_full_size": {
                        "description": "封面全尺寸",
                        "type": "bool",
                        "hint": "开启后按封面原始宽高比展示（不裁切为固定高度）",
                        "default": false
                    },
                    "show_play_button": {
                        "description": "封面播放按钮",
                        "type": "bool",
                        "hint": "开启后在视频封面中央显示播放按钮",
                        "default": false
                    },
                    "watermark": {
                        "description": "卡片右下角署名",
                        "type": "string",
                        "hint": "留空使用 Nova解析；最多 32 个字符。",
                        "default": "Nova解析"
                    },
                    "include_hot_comments": {
                        "description": "热评合并到卡片",
                        "type": "bool",
                        "hint": "开启后，把已获取的热评追加到同一张卡片中；卡片最多展示前 5 条。是否另外发送热评文本由“在普通文本中显示热评”决定。",
                        "default": false
                    },
                    "hot_comment_max_chars": {
                        "description": "卡片单条热评字数上限",
                        "type": "int",
                        "hint": "范围 60-600，默认 180。插件会先按此上限截断过长热评，再把保留内容完整换行显示，避免固定三行造成突兀截断。",
                        "default": 180
                    }
                }
            },
            "hot_comments": {
                "description": "附加内容：热评",
                "type": "object",
                "hint": "仅对输出模式包含文本的支持平台生效；先将条数设为大于 0，下面的平台开关才有作用。",
                "items": {
                    "count": {
                        "description": "热评条数",
                        "type": "int",
                        "hint": "填 0 不获取热评；大于 0 后再按下面的平台开关选择来源。某个平台在“解析输出内容”里没有勾选文本时，该平台的热评条数会归零、本项对它不生效。",
                        "default": 0
                    },
                    "show_in_text": {
                        "description": "在普通文本中显示热评",
                        "type": "bool",
                        "hint": "关闭后，热评不会作为普通文本发送，但仍可参与翻译，并可在开启“热评合并到卡片”后只显示在卡片中。卡片模式仍负责卡片与普通文本的整体发送关系。",
                        "default": true
                    },
                    "bilibili": {
                        "description": "B站",
                        "type": "bool",
                        "default": true
                    },
                    "weibo": {
                        "description": "微博",
                        "type": "bool",
                        "default": true
                    },
                    "xiaohongshu": {
                        "description": "小红书",
                        "type": "bool",
                        "default": true
                    },
                    "twitter": {
                        "description": "Twitter/X",
                        "type": "bool",
                        "hint": "X 已不再对未登录访问输出回复数据，需在下方填写 Nitter 实例地址才能拿到热评；未配置时会尝试公开帖子页并在失败后自动跳过。",
                        "default": true
                    },
                    "xiaoheihe": {
                        "description": "小黑盒",
                        "type": "bool",
                        "hint": "仅对小黑盒 BBS 帖子生效；使用帖子详情接口返回的热门评论，不影响游戏详情页。",
                        "default": true
                    },
                    "twitter_nitter_base_url": {
                        "description": "Twitter/X 的 Nitter 实例地址",
                        "type": "string",
                        "hint": "留空则不使用。X 已停止对未登录访问输出带回复的服务端渲染页，填入一个可用的 Nitter 实例（例如自建的 http://127.0.0.1:8585）后即可恢复 Twitter 热评，并顺带补全推文的喜欢/转发/评论/阅读统计。可用逗号分隔多个实例按顺序回退；指向本机或内网的地址会自动绕过代理。",
                        "default": ""
                    }
                }
            },
            "opening": {
                "description": "发送行为：开场语",
                "type": "object",
                "hint": "仅在存在可发送的富媒体时发送；仅文本结果或媒体全部失败时不会发送。",
                "items": {
                    "enable": {
                        "description": "发送开场语",
                        "type": "bool",
                        "default": true
                    },
                    "content": {
                        "description": "开场语内容",
                        "type": "string",
                        "condition": {
                            "enable": true
                        },
                        "default": "流媒体解析bot为您服务 ٩( 'ω' )و"
                    }
                }
            },
            "packing": {
                "description": "发送行为：消息聚合",
                "type": "object",
                "hint": "控制是否使用合并转发消息；ZIP 归档独立于此设置。NapCat 存在兼容问题，请按需启用。",
                "items": {
                    "mode": {
                        "description": "聚合模式",
                        "type": "string",
                        "options": [
                            "不聚合",
                            "全部聚合",
                            "按条件聚合"
                        ],
                        "default": "不聚合"
                    },
                    "zip_command": {
                        "description": "旧归档命令（自动迁移）",
                        "type": "string",
                        "default": "",
                        "invisible": true
                    },
                    "thresholds": {
                        "description": "按条件聚合阈值",
                        "type": "object",
                        "hint": "仅在选择“按条件聚合”时生效；0 = 不按该项触发。",
                        "condition": {
                            "mode": "按条件聚合"
                        },
                        "items": {
                            "image_count": {
                                "description": "图片数量",
                                "type": "int",
                                "hint": "图片总数达到该值时聚合；0 = 不按图片数触发",
                                "default": 3
                            },
                            "video_count": {
                                "description": "视频数量",
                                "type": "int",
                                "hint": "视频总数达到该值时聚合；0 = 不按视频数触发",
                                "default": 2
                            },
                            "node_count": {
                                "description": "节点数量",
                                "type": "int",
                                "hint": "文本、图片和视频节点总数达到该值时聚合；0 = 不按节点数触发",
                                "default": 5
                            }
                        }
                    }
                }
            },
            "archive": {
                "description": "导出行为：ZIP 归档",
                "type": "object",
                "hint": "ZIP 归档与聊天消息聚合相互独立。",
                "items": {
                    "command": {
                        "description": "引用链接归档命令",
                        "type": "string",
                        "hint": "引用含可解析链接的消息并单独发送此命令，将解析详情和可下载媒体导出为 ZIP；留空关闭。命令不能与清缓存命令相同。",
                        "default": ""
                    },
                    "max_total_size_mb": {
                        "description": "归档媒体总大小上限（MB）",
                        "type": "float",
                        "hint": "仅在填写归档命令后有作用。所有待归档媒体总大小超过该值时拒绝创建 ZIP；有效范围 1–4096 MB。",
                        "default": 1024.0
                    }
                }
            }
        }
    },
    "translation": {
        "description": "文本翻译",
        "type": "object",
        "hint": "默认关闭。启用后翻译正文/标题；翻译失败不会影响媒体解析。未启用时下面的翻译参数会被忽略。",
        "items": {
            "enable": {
                "description": "启用翻译",
                "type": "bool",
                "default": false
            },
            "content_scope": {
                "description": "翻译范围",
                "type": "string",
                "condition": {
                    "enable": true
                },
                "options": [
                    "仅正文",
                    "正文和标题"
                ],
                "hint": "仅正文只翻译简介/正文；正文和标题会同时翻译标题和简介/正文。只要解析结果带有热评，热评正文会一并翻译。仅启用翻译后生效。",
                "default": "正文和标题"
            },
            "apply_scope": {
                "description": "译文应用范围",
                "type": "string",
                "condition": {
                    "enable": true
                },
                "options": [
                    "仅卡片使用译文",
                    "卡片和文本均使用译文"
                ],
                "hint": "只决定译文替换哪些展示内容，不决定是否发送普通文本。仅卡片使用译文：卡片显示译文，普通文本保留原文；卡片和文本均使用译文：卡片与普通文本都显示译文。普通文本是否发送由“卡片模式”决定。",
                "default": "卡片和文本均使用译文"
            },
            "output_mode": {
                "description": "旧译文应用范围（自动迁移）",
                "type": "string",
                "default": "",
                "invisible": true
            },
            "target_language": {
                "description": "目标语言",
                "type": "string",
                "condition": {
                    "enable": true
                },
                "options": [
